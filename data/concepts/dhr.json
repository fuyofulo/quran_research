      "ayah_arabic": "هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينࣱ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـࣰٔ ا مَّذۡكُورًا",
      "surah_revelation": "Medinan",
      "surah_name": "Al-Insaan",
      "literal_gloss": "time",
      "translations": {
        "saheeh": "Has there [not] come upon man a period of time when he was not a thing [even] mentioned?",
        "pickthall": "Hath there come upon man (ever) any period of time in which he was a thing unremembered?",
        "khattab": "Is there not a period of time when each human is nothing yet worth mentioning",
        "arberry": "Has there come on man a while of time when he was a thing unremembered?"
      }
