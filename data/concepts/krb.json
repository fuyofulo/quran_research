      "ayah_arabic": "قُلِ ٱللَّهُ يُنَجِّيكُم مِّنۡهَا وَمِن كُلِّ كَرۡبࣲ ثُمَّ أَنتُمۡ تُشۡرِكُونَ",
      "surah_revelation": "Meccan",
      "surah_name": "Al-An'aam",
      "literal_gloss": "distress",
      "translations": {
        "saheeh": "Say, \"It is Allah who saves you from it and from every distress; then you [still] associate others with Him.\"",
        "pickthall": "Say: Allah delivereth you from this and from all affliction. Yet ye attribute partners unto Him.",
        "khattab": "Say, “˹Only˺ Allah rescues you from this and any other distress, yet you associate others with Him ˹in worship˺.”",
        "arberry": "Say: 'God delivers you from them and from every distress; then you assign Him associates.'"
      }
    },
