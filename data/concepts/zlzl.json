      "ayah_arabic": "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُواْ رَبَّكُمۡۚ إِنَّ زَلۡزَلَةَ ٱلسَّاعَةِ شَيۡءٌ عَظِيمࣱ‏",
      "surah_revelation": "Medinan",
      "surah_name": "Al-Hajj",
      "literal_gloss": "(the) convulsion",
      "translations": {
        "saheeh": "O mankind, fear your Lord. Indeed, the convulsion of the [final] Hour is a terrible thing.",
        "pickthall": "O mankind! Fear your Lord. Lo! the earthquake of the Hour (of Doom) is a tremendous thing.",
        "khattab": "O humanity! Fear your Lord, for the ˹violent˺ quaking at the Hour is surely a dreadful thing",
        "arberry": "O men, fear your Lord! Surely the earthquake of the Hour is a mighty thing;"
      }
    },
