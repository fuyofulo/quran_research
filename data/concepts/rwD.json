      "ayah_id": "30:15",
      "ayah_arabic": "فَأَمَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَهُمۡ فِي رَوۡضَةࣲ يُحۡبَرُونَ",
      "surah_revelation": "Meccan",
      "surah_name": "Ar-Room",
      "literal_gloss": "a Garden",
      "translations": {
        "saheeh": "And as for those who had believed and done righteous deeds, they will be in a garden [of Paradise], delighted.",
        "pickthall": "As for those who believed and did good works, they will be made happy in a Garden.",
        "khattab": "As for those who believed and did good, they will be rejoicing in a Garden",
        "arberry": "as for those who believed, and did deeds of righteousness, they shall walk with joy in a green meadow,"
      }
    },
    {
      "location": [
