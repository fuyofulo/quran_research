      "ayah_id": "72:25",
      "ayah_arabic": "قُلۡ إِنۡ أَدۡرِيٓ أَقَرِيبࣱ مَّا تُوعَدُونَ أَمۡ يَجۡعَلُ لَهُۥ رَبِّيٓ أَمَدًا",
      "surah_revelation": "Meccan",
      "surah_name": "Al-Jinn",
      "literal_gloss": "a (distant) term",
      "translations": {
        "saheeh": "Say, \"I do not know if what you are promised is near or if my Lord will grant for it a [long] period.\"",
        "pickthall": "Say (O Muhammad, unto the disbelievers): I know not whether that which ye are promised is nigh, or if my Lord hath set a distant term for it.",
        "khattab": "Say, “I do not know if what you are promised is near or my Lord has set a distant time for it",
        "arberry": "Say: 'I do not know whether that which you are promised is nigh, or whether my Lord will appoint for it a space;"
      }
    }
