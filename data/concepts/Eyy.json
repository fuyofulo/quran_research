      ],
      "form_arabic": "أَفَعَيِينَا",
      "lemma": "Eayiy",
      "lemma_arabic": "عَيِي",
      "pos": "V",
      "ayah_id": "50:15",
      "ayah_arabic": "أَفَعَيِينَا بِٱلۡخَلۡقِ ٱلۡأَوَّلِۚ بَلۡ هُمۡ فِي لَبۡسࣲ مِّنۡ خَلۡقࣲ جَدِيدࣲ‏",
      "surah_revelation": "Meccan",
      "surah_name": "Qaaf",
      "literal_gloss": "Were We then tired",
      "translations": {
        "saheeh": "Did We fail in the first creation? But they are in confusion over a new creation.",
        "pickthall": "Were We then worn out by the first creation? Yet they are in doubt about a new creation.",
        "khattab": "Were We incapable of creating ˹them˺ the first time? In fact, they are in doubt about ˹their˺ re-creation",
        "arberry": "What, were We wearied by the first creation? No indeed; but they are in uncertainty as to the new creation."
      }
    }
