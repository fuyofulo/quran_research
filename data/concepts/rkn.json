      "ayah_id": "11:80",
      "ayah_arabic": "قَالَ لَوۡ أَنَّ لِي بِكُمۡ قُوَّةً أَوۡ ءَاوِيٓ إِلَىٰ رُكۡنࣲ شَدِيدࣲ‏",
      "surah_revelation": "Meccan",
      "surah_name": "Hud",
      "literal_gloss": "a support",
      "translations": {
        "saheeh": "He said, \"If only I had against you some power or could take refuge in a strong support.\"",
        "pickthall": "He said: Would that I had strength to resist you or had some strong support (among you)!",
        "khattab": "He responded, “If only I had the strength ˹to resist you˺ or could rely on a strong supporter.”",
        "arberry": "He said, 'O would that I had power against you, or might take refuge in a strong pillar!'"
      }
    },
    {
      "location": [
        11,
        113,
        2
      ],
      "form_arabic": "تَرْكَنُو^ا@",
      "lemma": "tarokanu",
      "lemma_arabic": "تَرْكَنُ",
      "pos": "V",
      "ayah_id": "11:113",
      "ayah_arabic": "وَلَا تَرۡكَنُوٓاْ إِلَى ٱلَّذِينَ ظَلَمُواْ فَتَمَسَّكُمُ ٱلنَّارُ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِنۡ أَوۡلِيَآءَ ثُمَّ لَا تُنصَرُونَ",
      "surah_revelation": "Meccan",
      "surah_name": "Hud",
      "literal_gloss": "incline",
      "translations": {
        "saheeh": "And do not incline toward those who do wrong, lest you be touched by the Fire, and you would not have other than Allah any protectors; then you would not be helped.",
        "pickthall": "And incline not toward those who do wrong lest the Fire touch you, and ye have no protecting friends against Allah, and afterward ye would not be helped.",
        "khattab": "And do not be inclined to the wrongdoers or you will be touched by the Fire. For then you would have no protectors other than Allah, nor would you be helped",
        "arberry": "And lean not on the evildoers, so that the Fire touches you -- you have no protectors apart from God -- and then you will not be helped."
      }
    },
